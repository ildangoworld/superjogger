# Supabase (public — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
# Prefer publishable key; anon key is accepted as fallback
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server only — never expose to client)
# Required for account deletion and background AI analysis
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (server only, OpenAI-compatible Chat Completions)
AI_API_KEY=
AI_MODEL=
# Optional; defaults to https://api.openai.com/v1
AI_BASE_URL=

# App URL (local or production origin, no trailing slash)
# Local: http://localhost:3000
# Vercel: https://YOUR_PROJECT.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin bootstrap (server only — initial SUPER login id/password)
# After password change in /admin, signing in again with these values resets Auth password
ADMIN_ID=
ADMIN_PASSWORD=

# Production checklist (Supabase Dashboard)
# 1. Authentication > URL Configuration
#    - Site URL = NEXT_PUBLIC_APP_URL
#    - Redirect URLs include {NEXT_PUBLIC_APP_URL}/auth/callback
# 2. Google provider enabled with the same callback URL
# Apply migrations 20260807000000 … 20260808010000 in order
